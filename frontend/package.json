{
  "name": "pinas-frontend",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@iconify/svelte": "^5.0.0"
  },
  "type": "module"
}
