[Unit]
Description=PiNAS Samba NMB Daemon
After=network-online.target pinas-smbd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/nmbd --foreground --no-process-group --configfile=/storage/.pinas/data/samba/smb.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
