# Development environment configuration
PINAS_BIND_ADDRESS=0.0.0.0:3388
PINAS_DATABASE_URL=sqlite:./data/pinas.db?mode=rwc
PINAS_JWT_SECRET=dev-secret-change-in-production
PINAS_FILES_ROOT=./data/files

# Package manager directories (for local dev)
PINAS_DATA_DIR=./data
PINAS_PACKAGES_DIR=./data/packages
PINAS_DOWNLOADS_DIR=./data/downloads
PINAS_BIN_DIR=./data/bin

PINAS_DEV_MODE=true

# App catalog (can be local or remote URL)
# PINAS_CATALOG_URL=https://raw.githubusercontent.com/pinas/app-catalog/main/catalog.json
